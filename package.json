{
  "name": "mark-parse-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MarkParse Core - a fast, extensible Markdown parser core in TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "concurrently \"npm:build:watch\" \"serve . -l 5173\"",
    "build:watch": "tsc -p tsconfig.json -w"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "rimraf": "^6.0.1",
    "serve": "^14.2.3",
    "typescript": "^5.6.3"
  }
}


